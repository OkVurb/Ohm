{
  "name": "ohm",
  "version": "0.1.3",
  "private": true,
  "description": "Desktop Luau workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "smoke": "node scripts/smoke.cjs",
    "dist": "npm run check && electron-builder --win nsis portable",
    "check": "node electron/core.test.cjs && node electron/offline.test.cjs && node --test electron/storage.test.cjs electron/startup.test.cjs electron/injection.test.cjs electron/recovery.test.cjs src/save.test.mjs src/recovery.test.mjs && node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/main.js && npm run build"
  },
  "build": {
    "appId": "app.ohm.desktop",
    "productName": "Ohm",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/main.cjs", "electron/preload.cjs", "electron/core.cjs", "electron/offline.cjs", "electron/storage.cjs", "electron/recovery.cjs", "electron/injection.js", "src/injector/injection.js", "assets/ohm-icon.ico", "package.json"],
    "extraResources": [{ "from": "vendor/luau", "to": "luau", "filter": ["luau.exe", "LICENSE.txt"] }],
    "win": { "target": ["nsis", "portable"], "icon": "assets/ohm-icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Ohm-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "Ohm-Portable-${version}-${arch}.${ext}" }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "monaco-editor": "0.57.0",
    "vite": "8.3.4"
  }
}
